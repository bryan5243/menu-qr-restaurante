# Para hostings donde todo el proyecto queda dentro de htdocs/ o public_html/
# (por ejemplo, hostings gratuitos). Sirve la carpeta public/ como raíz y
# bloquea config/, src/, database/ y los archivos internos.
# Si subes solo el contenido de public/ a public_html/, este archivo no se usa.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule "(^|/)\.(?!well-known)" - [F]
  RewriteRule "^(config|src|database|storage)(/|$)" - [F]
  RewriteRule "\.(md|sql|log|sqlite|sqlite-wal|sqlite-shm)$" - [F]

  RewriteRule "^admin$" %{REQUEST_URI}/ [R=301,L]

  RewriteCond %{REQUEST_URI} !/public/
  RewriteRule "^(.*)$" public/$1 [L]
</IfModule>
